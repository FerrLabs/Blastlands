{
  "$schema": "https://ferrflow.com/schema/ferrflow.json",
  "workspace": {
    "versioning": "calver-short-seq",
    "tagTemplate": "v{version}"
  },
  "package": [
    {
      "name": "blastlands",
      "path": ".",
      "changelog": "CHANGELOG.md",
      "versionedFiles": [
        {
          "path": "VERSION",
          "format": "txt"
        },
        {
          "path": "client/ProjectSettings/ProjectSettings.asset",
          "format": "txt",
          "selector": "(?m)^\\s*bundleVersion: (.+)$"
        }
      ]
    }
  ]
}
