<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Blastlands.Core.Tests</AssemblyName>
    <RootNamespace>Blastlands.Core.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both globs are recursive, and neither may reach a file that references
         UnityEngine. This project is what proves the simulation builds without the
         engine, and CI compiles it on a runner that has no Unity on it at all.

         Tests that do need the engine live in client/Assets/_Game/Tests/Runtime,
         outside Tests/EditMode on purpose. Put one under EditMode and it is picked up
         here silently, and the build fails with a missing-namespace error that says
         nothing about the rule it broke. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\client\Assets\_Game\Core\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\client\Assets\_Game\Tests\EditMode\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

</Project>
